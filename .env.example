# ==============================================================================
# EventFlow OS — Environment Configuration Example
# Copy to .env and fill in real values for production. Never commit .env!
# ==============================================================================

# --- Runtime ---
NODE_ENV=development
API_PORT=4000
HOST=0.0.0.0
APP_NAME="EventFlow OS"
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata

# --- URLs & CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/eventflow_os
MONGODB_DB_NAME=eventflow_os
# Set to true only in local dev/test when external MongoDB is unavailable (uses mongodb-memory-server)
USE_IN_MEMORY_MONGO=false

# --- Authentication & Security ---
JWT_ACCESS_SECRET=change-this-to-a-64-char-random-hex-string-for-access-tokens
JWT_REFRESH_SECRET=change-this-to-a-64-char-random-hex-string-for-refresh-tokens
COOKIE_SECURE=false
QR_SIGNING_SECRET=change-this-qr-hmac-secret-key
OTP_EXPIRES_MINUTES=10

# --- Single Admin Bootstrap (Used only during initial seed/bootstrap) ---
ADMIN_EMAIL=admin@eventflow.local
ADMIN_NAME=EventFlow Admin
ADMIN_PASSWORD=ChangeMe@StrongAdminPassword123!

# --- Reservations & Booking ---
RESERVATION_EXPIRY_MINUTES=15
MAX_TICKETS_PER_BOOKING=10

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OTP_MAX=5

# --- PhonePe Payment Gateway ---
# Options: 'development' | 'phonepe_uat' | 'phonepe_prod'
PAYMENT_PROVIDER_MODE=development
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PHONEPE_CALLBACK_URL=http://localhost:4000/api/v1/payments/webhook/phonepe
PHONEPE_REDIRECT_URL=http://localhost:5173/payment/callback

# --- WhatsApp Business API (Meta Cloud API) ---
# Options: 'development' | 'meta_cloud'
WHATSAPP_PROVIDER_MODE=development
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Email Provider (SMTP) ---
# Options: 'development' | 'smtp'
EMAIL_PROVIDER_MODE=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EventFlow OS <tickets@eventflow.local>"

# --- Object Storage (MongoDB, Local Disk, or S3-Compatible) ---
# Options: 'mongodb' | 'local' | 's3'
STORAGE_PROVIDER_MODE=mongodb
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=eventflow-os-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Client Build ---
VITE_API_BASE_URL=/api/v1

# --- Initial Event Defaults ---
DEFAULT_EVENT_CODE=NOD
DEFAULT_EVENT_NAME="Night of Devotion"
DEFAULT_EVENT_SUBTITLE="Nirantaram Sanatanam"
DEFAULT_EVENT_DATE="2026-12-05T18:00:00+05:30"
DEFAULT_VENUE_NAME="Exhibition Grounds"
DEFAULT_VENUE_ADDRESS="GAIL Office / A.V. Apparao Road area, Rajahmundry, Andhra Pradesh, India"
